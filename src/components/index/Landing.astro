---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

import Container from '../global/Container.vue';
import propic from '../../assets/propic.jpg';
import Navbar from '../global/Navbar.astro';
import ascii from '../../assets/ascii.svg';
import Button from '../global/Button.vue';
import Terminal from './Terminal.vue';

// icons
import linkedin from '../../assets/icons/linkedin.svg?raw';
import github from '../../assets/icons/github.svg?raw';

const writeup = await getEntry('writeups', 'exception-handler-easy');
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<section class="w-full h-fit flex flex-col justify-center items-center p-2 md:p-5">

  <div class="w-full h-full flex flex-col justify-between items-center lg:flex-row">

    <!-- Left/upper content -->
    <div class="w-full lg:w-2/5 h-full flex flex-col justify-center gap-3">
      <div class="w-fit flex flex-col gap-2">
        <!-- Name and propic -->
        <div class="w-full flex flex-row items-end gap-2">
          <div class="w-fit h-fit">
            <img src={propic.src} class="w-12 rounded-4xl" />
          </div>
          <h1 class="text-white text-3xl md:text-4xl font-mono font-semibold">
            e3py || lmvjack
          </h1>
        </div>

        <!-- Short description -->
        <div class="w-full">
          <p class="text-white text-lg font-sans">
            Computer science BSc student; programming and cybersecurity enjoyer. 
          </p>
        </div>
      </div>

      <!-- Buttons -->
      <div class="w-fit h-fit flex flex-row items-center gap-2">
        <a href="mailto:e3py@pwnissa.it" target="_blank">
          <Button text="Contact me" size="md" mode="solid" />
        </a>
        <div class="flex flex-row flex-wrap gap-2 ">
          <a href="https://github.com/lmvjack" target="_blank">
            <Button icon={github} size="md" mode="outline" />
          </a>
          <a href="https://www.linkedin.com/in/giacomo-quarto-a252283b9" target="_blank">
            <Button icon={linkedin} size="md" mode="outline" />
          </a>
        </div>
      </div>

    </div>

    <!-- Right/lower content -->
    <Image class="w-full md:w-lg opacity-40" src={ascii} alt="Ascii art planet" />
  </div>

  <div class="w-full h-full">
    <Terminal></Terminal>
  </div>
  
</section>